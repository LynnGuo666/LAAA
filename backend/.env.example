# Application
APP_NAME="Personal OAuth Server"
DEBUG=False
# 必改:生产环境必须替换为≥32字符的随机串,否则启动失败(占位串会被拒绝)
# 用于 refresh token 签名(HS256,不对外暴露)及 TOTP 密钥派生
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256

# JWT 签名(RS256 非对称):access/id token 用私钥签发,公钥经 JWKS 暴露。
# 首次部署用 `python scripts/generate_jwt_keys.py --out-dir ./jwt_keys` 生成密钥对。
# 生产建议通过 docker secrets / 挂载文件注入私钥,勿明文入 .env。
JWT_PRIVATE_KEY_PATH=jwt_keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=jwt_keys/jwt_public.pem
# JWT_KEY_ID=  # 可选,留空则用公钥 DER 的 sha256[:16]

# Database
DATABASE_URL=sqlite:///./oauth.db

# Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_REMEMBER_ME_DAYS=30

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Server
HOST=0.0.0.0
PORT=8000

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:8000

# WebAuthn / Passkey
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=LAAA OAuth Server
WEBAUTHN_RP_ORIGIN=http://localhost:8000

# Registration control
ALLOW_OPEN_REGISTRATION=false
BOOTSTRAP_ALLOW_FIRST_USER=true

# Session security
DEFAULT_MAX_SESSIONS=3
ENABLE_LOGIN_ANOMALY_DETECTION=true

# GeoIP (MaxMind database)
GEOIP_ENABLED=true
GEOIP_DATABASE_PATH=data/GeoLite2-City.mmdb

# Risk-based verification
RISK_SCORE_MEDIUM=3
RISK_SCORE_HIGH=5
BLOCK_SUSPICIOUS_LOGIN=true

# Verification settings
VERIFICATION_CODE_EXPIRE_MINUTES=5
VERIFICATION_CODE_MAX_ATTEMPTS=5
MAGIC_LINK_EXPIRE_MINUTES=15

# TOTP
TOTP_ISSUER=LAAA OAuth Server

# =============================================================================
# SMTP Email Configuration
# =============================================================================
# 启用/禁用邮件功能
SMTP_ENABLED=false

# -----------------------------------------------------------------------------
# 163邮箱配置示例 (SSL端口465)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# SMTP_USERNAME=your-email@163.com
# SMTP_PASSWORD=your-authorization-code  # 163邮箱授权码，非登录密码
# SMTP_FROM_EMAIL=your-email@163.com
# SMTP_FROM_NAME=LAAA OAuth Server
# SMTP_USE_TLS=false
# SMTP_USE_SSL=true

# -----------------------------------------------------------------------------
# QQ邮箱配置示例 (SSL端口465)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USERNAME=your-qq@qq.com
# SMTP_PASSWORD=your-authorization-code  # QQ邮箱授权码
# SMTP_FROM_EMAIL=your-qq@qq.com
# SMTP_FROM_NAME=LAAA OAuth Server
# SMTP_USE_TLS=false
# SMTP_USE_SSL=true

# -----------------------------------------------------------------------------
# Gmail配置示例 (STARTTLS端口587)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password  # Gmail应用专用密码
# SMTP_FROM_EMAIL=your-email@gmail.com
# SMTP_FROM_NAME=LAAA OAuth Server
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# -----------------------------------------------------------------------------
# 阿里云企业邮箱配置示例 (SSL端口465)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.qiye.aliyun.com
# SMTP_PORT=465
# SMTP_USERNAME=your-email@your-domain.com
# SMTP_PASSWORD=your-password
# SMTP_FROM_EMAIL=your-email@your-domain.com
# SMTP_FROM_NAME=LAAA OAuth Server
# SMTP_USE_TLS=false
# SMTP_USE_SSL=true

# -----------------------------------------------------------------------------
# 常见邮件服务商端口参考
# -----------------------------------------------------------------------------
# 服务商        | SMTP服务器           | 非SSL端口 | SSL端口
# -------------|---------------------|----------|--------
# 163邮箱       | smtp.163.com        | 25       | 465
# QQ邮箱        | smtp.qq.com         | 25       | 465
# Gmail        | smtp.gmail.com      | 587(TLS) | 465
# Outlook      | smtp.office365.com  | 587(TLS) | -
# 阿里云企业邮箱 | smtp.qiye.aliyun.com| 25       | 465
# 腾讯企业邮箱   | smtp.exmail.qq.com  | 25       | 465
