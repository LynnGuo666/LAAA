# Application
APP_NAME="Personal OAuth Server"
DEBUG=False
# 必改:生产环境必须替换为≥32字符的随机串,否则启动失败(占位串会被拒绝)
# 用于 refresh token 签名(HS256,不对外暴露)及 TOTP 密钥派生
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256

# JWT 签名(RS256 非对称):access/id token 用私钥签发,公钥经 JWKS 暴露。
# 首次部署用 `python scripts/generate_jwt_keys.py --out-dir ./jwt_keys` 生成密钥对。
# 生产建议通过 docker secrets / 挂载文件注入私钥,勿明文入 .env。
JWT_PRIVATE_KEY_PATH=jwt_keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=jwt_keys/jwt_public.pem
# JWT_KEY_ID=  # 可选,留空则用公钥 DER 的 sha256[:16]

# 速率限制存储(slowapi)。单实例留空用内存;多 worker 设共享存储:
# RATELIMIT_STORAGE_URI=redis://redis:6379
RATELIMIT_STORAGE_URI=

# 可观测性(均默认关闭,按需开启)
# LOG_FORMAT=json 启用结构化 JSON 日志(便于采集到 ELK/Loki);留空=人类可读
LOG_FORMAT=
# SENTRY_DSN 设置后启用错误上报(sentry-sdk);留空=不上报
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production   # 上报环境标签,默认 production

# Database
DATABASE_URL=sqlite:///./oauth.db

# internal OAuth 客户端 secret(可选)
# 不设则首次 seed/init 时随机生成并打印一次(仅此一次,请立即保存);
# 存量库若仍是历史硬编码默认值,非 DEBUG 模式启动时会自动轮换为随机值。
# docker-compose 部署建议显式注入:`openssl rand -base64 32` 生成。
# INTERNAL_CLIENT_SECRET=

# Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_REMEMBER_ME_DAYS=30
# 受限会话(跳过验证登录)的 access token 时效,只签发短 TTL 受限 token、无 refresh
RESTRICTED_ACCESS_TOKEN_EXPIRE_MINUTES=5

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Server
HOST=0.0.0.0
PORT=8000

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:8000

# WebAuthn / Passkey
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=LAAA OAuth Server
WEBAUTHN_RP_ORIGIN=http://localhost:8000

# Registration control
ALLOW_OPEN_REGISTRATION=false
BOOTSTRAP_ALLOW_FIRST_USER=true

# Session security
DEFAULT_MAX_SESSIONS=3
ENABLE_LOGIN_ANOMALY_DETECTION=true

# GeoIP (MaxMind database)
GEOIP_ENABLED=true
GEOIP_DATABASE_PATH=data/GeoLite2-City.mmdb
# ip2region(中国 IP 省级定位)
IP2REGION_ENABLED=true
IP2REGION_DATABASE_PATH=data/ip2region.xdb

# 代理头信任:默认 false(直连时 XFF 可伪造)。
# 推荐形态:反代 + uvicorn --proxy-headers + FORWARDED_ALLOW_IPS,无需开此开关
TRUST_PROXY_HEADERS=false

# Risk-based verification
RISK_SCORE_MEDIUM=3
RISK_SCORE_HIGH=5
BLOCK_SUSPICIOUS_LOGIN=true

# 登录异常检测阈值
SUSPICIOUS_IP_CHANGE_HOURS=1
SUSPICIOUS_LOCATION_DISTANCE_KM=500
SUSPICIOUS_LOGIN_VELOCITY_MINUTES=5
SUSPICIOUS_LOGIN_VELOCITY_COUNT=5

# Verification settings
VERIFICATION_CODE_EXPIRE_MINUTES=5
VERIFICATION_CODE_MAX_ATTEMPTS=5
VERIFICATION_CODE_COOLDOWN_SECONDS=60
VERIFICATION_SESSION_EXPIRE_MINUTES=30
MAGIC_LINK_EXPIRE_MINUTES=15

# WebAuthn challenge 有效期(秒)
WEBAUTHN_CHALLENGE_TIMEOUT_SECONDS=300

# OIDC issuer(不设则按请求 Host 推断;生产建议固定,见 docs/oauth-integration.md)
# OIDC_ISSUER=https://auth.example.com

# 前端静态产物目录(默认 backend/../frontend/out;Docker 镜像内为 /app/frontend/out)
# STATIC_DIR=

# TOTP
TOTP_ISSUER=LAAA OAuth Server

# =============================================================================
# SMTP Email Configuration
# =============================================================================
# 启用/禁用邮件功能
SMTP_ENABLED=false
# SMTP 证书校验:默认校验(防中间人);仅证书异常的旧服务器才关
SMTP_VERIFY_TLS=true

# -----------------------------------------------------------------------------
# 163邮箱配置示例 (SSL端口465)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# SMTP_USERNAME=your-email@163.com
# SMTP_PASSWORD=your-authorization-code  # 163邮箱授权码，非登录密码
# SMTP_FROM_EMAIL=your-email@163.com
# SMTP_FROM_NAME=LAAA OAuth Server
# SMTP_USE_TLS=false
# SMTP_USE_SSL=true

# -----------------------------------------------------------------------------
# QQ邮箱配置示例 (SSL端口465)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USERNAME=your-qq@qq.com
# SMTP_PASSWORD=your-authorization-code  # QQ邮箱授权码
# SMTP_FROM_EMAIL=your-qq@qq.com
# SMTP_FROM_NAME=LAAA OAuth Server
# SMTP_USE_TLS=false
# SMTP_USE_SSL=true

# -----------------------------------------------------------------------------
# Gmail配置示例 (STARTTLS端口587)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password  # Gmail应用专用密码
# SMTP_FROM_EMAIL=your-email@gmail.com
# SMTP_FROM_NAME=LAAA OAuth Server
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# -----------------------------------------------------------------------------
# 阿里云企业邮箱配置示例 (SSL端口465)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.qiye.aliyun.com
# SMTP_PORT=465
# SMTP_USERNAME=your-email@your-domain.com
# SMTP_PASSWORD=your-password
# SMTP_FROM_EMAIL=your-email@your-domain.com
# SMTP_FROM_NAME=LAAA OAuth Server
# SMTP_USE_TLS=false
# SMTP_USE_SSL=true

# -----------------------------------------------------------------------------
# 常见邮件服务商端口参考
# -----------------------------------------------------------------------------
# 服务商        | SMTP服务器           | 非SSL端口 | SSL端口
# -------------|---------------------|----------|--------
# 163邮箱       | smtp.163.com        | 25       | 465
# QQ邮箱        | smtp.qq.com         | 25       | 465
# Gmail        | smtp.gmail.com      | 587(TLS) | 465
# Outlook      | smtp.office365.com  | 587(TLS) | -
# 阿里云企业邮箱 | smtp.qiye.aliyun.com| 25       | 465
# 腾讯企业邮箱   | smtp.exmail.qq.com  | 25       | 465
